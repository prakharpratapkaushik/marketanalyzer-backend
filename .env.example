# Only used by docker compose for local PostgreSQL. Do not commit a real .env file.
POSTGRES_DB=marketanalyzer
POSTGRES_USER=marketanalyzer
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Set these when running the application outside Docker.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marketanalyzer
SPRING_DATASOURCE_USERNAME=marketanalyzer
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-password
APP_AUTH_DEMO_EMAIL=demo@marketanalyzer.com
APP_AUTH_DEMO_PASSWORD=choose-a-strong-demo-password
